# AI провайдер: "ollama" (офлайн) немесе "openrouter" (бұлтты)
AI_PROVIDER=ollama

# Ollama (офлайн)
OLLAMA_BASE_URL=http://localhost:11434
# Модель таңдау:
#   qwen3.5:4b                                    — жылдам, 201 тіл (make use-qwen)
#   hf.co/inceptionai/Llama-3.1-Sherkala-8B-Chat  — қазақшаға арналған (make use-sherkala)
OLLAMA_MODEL=qwen3.5:4b

# OpenRouter (бұлтты, 300+ модель — https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=qwen/qwen3-235b-a22b

# Ауа райы (OpenWeatherMap тегін план)
WEATHER_API_KEY=your_api_key_here
DEFAULT_CITY=Алматы

# Piper TTS (офлайн дауыс)
PIPER_MODELS_DIR=~/.aidos/piper

# Музыка
MUSIC_DIR=~/Music

# Логтау
LOG_LEVEL=INFO

# Колонка шлюзы ↔ мозг (gRPC)
LINK_TOKEN=change_me_long_random_string
BRAIN_BIND=127.0.0.1:50051

# Колонка шлюзы (gateway/, Rust)
GATEWAY_BIND=0.0.0.0:8000
GATEWAY_PUBLIC_WS_URL=ws://192.168.1.10:8000/ws
BRAIN_ADDR=http://127.0.0.1:50051
GATEWAY_DEVICES=aa:bb:cc:dd:ee:ff=change_me_device_token
SILERO_MODEL=models/silero_vad.onnx

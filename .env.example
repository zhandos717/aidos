# Әдепкі AI провайдер (кейін UI ⚙ баптауларынан ауыстырылады):
# ollama | openrouter | agentrouter | anthropic | deepseek | openai | gemini
AI_PROVIDER=ollama

# Ollama (офлайн)
OLLAMA_BASE_URL=http://localhost:11434
# Модель таңдау:
#   qwen3.5:4b                                    — жылдам, 201 тіл (make use-qwen)
#   hf.co/inceptionai/Llama-3.1-Sherkala-8B-Chat  — қазақшаға арналған (make use-sherkala)
OLLAMA_MODEL=qwen3.5:4b

# OpenRouter (бұлтты, 300+ модель — https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=qwen/qwen3-235b-a22b

# AgentRouter
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=gpt-5

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI (LLM + STT gpt-4o-transcribe)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Whisper STT моделі: turbo | large-v3 | medium | small
WHISPER_MODEL=turbo

# Ауа райы (OpenWeatherMap тегін план)
WEATHER_API_KEY=your_api_key_here
DEFAULT_CITY=Алматы

# Piper TTS (офлайн дауыс)
PIPER_MODELS_DIR=~/.aidos/piper

# Музыка
MUSIC_DIR=~/Music

# Логтау
LOG_LEVEL=INFO
